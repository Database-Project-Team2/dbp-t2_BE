# 복사해서 .env로 사용 (cp .env.example .env). .env는 git에 올리지 않는다.
# docker compose와 Spring 서버가 같은 값을 읽는다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_project_management
DB_USERNAME=dbp
DB_PASSWORD=dbp1234
DB_ROOT_PASSWORD=root1234
# 주민번호 AES-256-GCM 키(base64 32바이트). 시드 암호문을 만든 키와 같아야 마스킹 값이 보인다.
# 팀 공용 키는 저장소에 올리지 않는다. 새로 만들려면: openssl rand -base64 32 후 ./gradlew seedSecrets
RESIDENT_NO_KEY=
# JWT 서명 키(32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=
